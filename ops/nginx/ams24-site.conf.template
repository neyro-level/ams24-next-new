# AMS24 static site Nginx template.
# Repository-side artifact only: replace placeholders during an explicitly
# approved release. Do not commit real upstream URLs, credentials or host paths.

server {
  listen 80;
  server_name {{PRODUCTION_SERVER_NAME}};

  root {{RELEASE_CURRENT}}/out;
  index index.html;

  charset utf-8;
  server_tokens off;

  include {{NGINX_SNIPPETS_DIR}}/production-security-headers.conf;

  location = /api/leads {
    proxy_pass {{LEADS_API_UPSTREAM}};
    proxy_http_version 1.1;
    proxy_set_header Host $proxy_host;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-AMS-Site "ams24";
    proxy_request_buffering on;
    client_max_body_size 128k;
  }

  location ^~ /_next/static/ {
    try_files $uri =404;
    include {{NGINX_SNIPPETS_DIR}}/production-security-headers.conf;
    add_header Cache-Control "public, max-age=31536000, immutable" always;
  }

  location = /404.html {
    internal;
    include {{NGINX_SNIPPETS_DIR}}/production-security-headers.conf;
    add_header Cache-Control "no-store" always;
    add_header X-Robots-Tag "noindex, follow" always;
  }

  location ~ ^/(?!_next(?:/|$))(?:.*/)?[^./]+$ {
    return 301 $uri/$is_args$args;
  }

  location / {
    try_files $uri $uri/index.html =404;
    include {{NGINX_SNIPPETS_DIR}}/production-security-headers.conf;
    add_header Cache-Control "public, max-age=60" always;
  }

  error_page 404 /404.html;
}

server {
  listen 80;
  server_name {{STAGING_SERVER_NAME}};

  root {{RELEASE_CURRENT}}/out;
  index index.html;

  auth_basic "AMS24 staging";
  auth_basic_user_file {{STAGING_BASIC_AUTH_FILE}};

  include {{NGINX_SNIPPETS_DIR}}/staging-security-headers.conf;

  location = /api/leads {
    proxy_pass {{LEADS_API_UPSTREAM}};
    proxy_http_version 1.1;
    proxy_set_header Host $proxy_host;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-AMS-Site "ams24-staging";
    proxy_request_buffering on;
    client_max_body_size 128k;
  }

  location ^~ /_next/static/ {
    try_files $uri =404;
    include {{NGINX_SNIPPETS_DIR}}/staging-security-headers.conf;
    add_header Cache-Control "public, max-age=31536000, immutable" always;
  }

  location = /404.html {
    internal;
    include {{NGINX_SNIPPETS_DIR}}/staging-security-headers.conf;
    add_header Cache-Control "no-store" always;
  }

  location ~ ^/(?!_next(?:/|$))(?:.*/)?[^./]+$ {
    return 301 $uri/$is_args$args;
  }

  location / {
    try_files $uri $uri/index.html =404;
    include {{NGINX_SNIPPETS_DIR}}/staging-security-headers.conf;
    add_header Cache-Control "public, max-age=60" always;
  }

  error_page 404 /404.html;
}
