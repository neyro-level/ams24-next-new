{
  "name": "ams24-next-new",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.8.1",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test:content": "vitest run tests/content",
    "verify:content-graph": "vitest run tests/verification/content-graph-daily.test.ts",
    "guard:static": "node scripts/verify-static-next.mjs",
    "guard:static:self-test": "node scripts/verify-static-next.mjs --self-test",
    "guard:artifact": "node scripts/verify-static-artifact.mjs",
    "verify:runtime": "node scripts/verify-runtime-versions.mjs",
    "verify:runtime:self-test": "node scripts/verify-runtime-versions.mjs --self-test",
    "verify:sourcecraft": "node scripts/verify-sourcecraft-ci.mjs",
    "verify:sourcecraft:self-test": "node scripts/verify-sourcecraft-ci.mjs --self-test",
    "verify:nginx": "node scripts/verify-nginx-contract.mjs",
    "verify:nginx:self-test": "node scripts/verify-nginx-contract.mjs --self-test",
    "verify": "pnpm verify:runtime:self-test && pnpm verify:runtime && pnpm typecheck && pnpm lint && pnpm verify:content-graph && pnpm test:content && pnpm verify:sourcecraft:self-test && pnpm verify:sourcecraft && pnpm verify:nginx:self-test && pnpm verify:nginx && pnpm guard:static:self-test && pnpm guard:static",
    "verify:release": "pnpm verify && pnpm build && pnpm guard:artifact"
  },
  "dependencies": {
    "@radix-ui/react-slot": "1.3.3",
    "@tailwindcss/postcss": "4.3.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.48.0",
    "next": "16.3.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.7",
    "typescript": "6.0.3",
    "vitest": "5.0.2"
  }
}
